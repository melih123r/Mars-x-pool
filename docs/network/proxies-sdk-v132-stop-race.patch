+    fun start() {
+        Log.d(TAG, "Starting SDK")
+        val requestEpoch: Long
+        synchronized(serviceTransitionLock) {
+            sharingRequested = true
+            requestEpoch = startEpoch.incrementAndGet()
+            updateStatus(Status.CONNECTING)
+        }
+
+        scope.launch {
+            try {
+                if (deviceId != null && refreshTokenValue != null) {
+                    refreshToken()
+                } else {
+                    registerDevice()
+                }
+
+                // Serialize the last-moment authorization check with stop().
+                // A delayed HTTP response must never restart a stopped relay.
+                synchronized(serviceTransitionLock) {
+                    if (!sharingRequested || startEpoch.get() != requestEpoch) {
+                        Log.d(TAG, "Discarding stale SDK start completion")
+                        return@synchronized
+                    }
+                    val token = deviceToken
+                    if (token != null) {
+                        val relay = config.relayUrl ?: assignedRelay ?: DEFAULT_RELAY_URL
+                        val relayPinned = config.relayUrl != null
+                        PeerProxyService.start(context, token, relay, relayPinned)
+                    } else {
+                        Log.e(TAG, "No device token available")
+                        updateStatus(Status.ERROR)
+                    }
+                }
+            } catch (e: Exception) {
+                synchronized(serviceTransitionLock) {
+                    if (sharingRequested && startEpoch.get() == requestEpoch) {
+                        Log.e(TAG, "Failed to start", e)
+                        updateStatus(Status.ERROR)
+                    }
+                }
+            }
+        }
+
+        startEarningsPolling()
+    }
+
+    /**
+     * Stop the bandwidth sharing service.
+     */
+    fun stop() {
+        Log.d(TAG, "Stopping SDK")
+        stopEarningsPolling()
+        synchronized(serviceTransitionLock) {
+            sharingRequested = false
+            startEpoch.incrementAndGet()
+            PeerProxyService.stop(context)
+            updateStatus(Status.STOPPED)
+        }
+    }

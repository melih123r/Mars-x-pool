{
  "name": "marsx-pool-worker-api",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check cloudflare/src/worker.js",
    "test": "node --test",
    "license:generate": "node license-tool.js",
    "cf:check": "wrangler deploy --dry-run --config cloudflare/wrangler.toml --outdir .wrangler-dist",
    "cf:db:local": "wrangler d1 migrations apply marsx-pool --local --config cloudflare/wrangler.toml",
    "global-engine:start": "node global-engine/api.js",
    "global-engine:test": "node --test test/global-engine*.test.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "redis": "6.2.0"
  },
  "devDependencies": {
    "wrangler": "4.42.0"
  }
}
